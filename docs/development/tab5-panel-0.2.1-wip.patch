+// Unmistakable high-contrast boot/diagnostic pattern (white outer frame + 4 corner RGBY blocks +
+// central cyan/white diamond target; distinct from vertical RGB color bars).
+inline void renderTab5BootPattern(uint16_t* fb640x360,
+                                  const Tab5UiState& ui,
+                                  const BatterySample& bat,
+                                  uint32_t now_ms) {
+  if (!fb640x360) return;
+  std::fill(fb640x360, fb640x360 + kUiWidth * kUiHeight, uint16_t(0x0000));
+  renderTab5StatusBar(fb640x360, ui, bat, now_ms);
+
+  // Bright solid WHITE perimeter frame around body region (0, 28, 640, 332).
+  uiDrawRect(fb640x360, 0, kStatusBarHeight, kUiWidth, kUiHeight - kStatusBarHeight, 0xffff, 14);
+
+  // Asymmetric corner blocks (NOT vertical bars): Red TL, Green TR, Blue BL, Yellow BR.
+  uiFillRect(fb640x360, 18, 46, 156, 126, 0xf800);
+  uiFillRect(fb640x360, 466, 46, 156, 126, 0x07e0);
+  uiFillRect(fb640x360, 18, 214, 156, 128, 0x001f);
+  uiFillRect(fb640x360, 466, 214, 156, 128, 0xffe0);
+
+  // Central diamond + cross target on black center.
+  const int cx = 320, cy = 194;
+  for (int dy = -108; dy <= 108; ++dy) {
+    for (int dx = -124; dx <= 124; ++dx) {
+      const int d = std::abs(dx) + std::abs(dy);
+      if (d >= 96 && d <= 112) {
+        fb640x360[(cy + dy) * kUiWidth + (cx + dx)] = 0xffff;
+      } else if (d >= 52 && d <= 64) {
+        fb640x360[(cy + dy) * kUiWidth + (cx + dx)] = 0x07ff;
+      }
+    }
+  }
+  uiFillRect(fb640x360, cx - 128, cy - 3, 256, 6, 0xffff);
+  uiFillRect(fb640x360, cx - 3, cy - 112, 6, 224, 0xffff);
+  uiFillRect(fb640x360, cx - 118, cy - 28, 236, 56, 0x0000);
+  uiDrawRect(fb640x360, cx - 118, cy - 28, 236, 56, 0x07ff, 3);
+  uiDrawText(fb640x360, cx - 102, cy - 14, "TAB5 0.2.1", 0xffff, 4);
+}
